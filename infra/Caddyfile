# OpenWind's web server: the built app, the model run files and basemap tiles, and /v1 proxied to the API.
# Plain HTTP on :8080. Put it behind your own HTTPS reverse proxy (or give Caddy a domain name instead of :8080
# and it will get a certificate itself; see docs/operations.md).
:8080 {
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/octet-stream*
			header Content-Type image/svg+xml*
		}
	}
	# Security headers (OWASP Secure Headers). The CSP allows only this site plus the NASA satellite tiles;
	# MapLibre runs its workers from blob: URLs.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://gibs.earthdata.nasa.gov; connect-src 'self' data: blob: https://gibs.earthdata.nasa.gov; worker-src 'self' blob:; child-src blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
	@api path /v1/* /healthz
	handle @api {
		# Only GET requests reach the API; nothing legitimate has a body.
		request_body {
			max_size 16KB
		}
		reverse_proxy api:8000
	}
	# Run folders never change once published, so they cache forever.
	handle_path /runs/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /runs
		file_server
	}
	# Basemap vector tiles; open ocean has no tile, which MapLibre takes as empty.
	handle_path /basemap/* {
		root * /basemap
		header Cache-Control "public, max-age=86400"
		@missing not file
		respond @missing 204
		file_server
	}
	# Built JS and CSS have content hashes in their names, so they never change at a URL.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}
	# Pages and everything else: always check for a newer copy (a cheap 304 when unchanged).
	handle {
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
